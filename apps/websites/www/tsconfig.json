{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@monorepo/tsconfig/start.json",
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules"]
}
